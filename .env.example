# Copy to .env and change every secret. Never commit .env (SDD §13).

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,django
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_COUNTRY=UGA
GPS_K_THRESHOLD=3
LOG_LEVEL=INFO
SENTRY_DSN=

# --- Database (PostGIS + h3-pg) ---
POSTGRES_DB=geoportal
POSTGRES_USER=geoportal
POSTGRES_PASSWORD=change-me
MARTIN_DB_PASSWORD=change-me-too
# Only used when running Django on the host; compose overrides it for containers.
DATABASE_URL=postgis://geoportal:change-me@localhost:5432/geoportal
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3 API; SeaweedFS locally, any S3 in prod) ---
S3_ENDPOINT=http://localhost:8333
S3_BUCKET_COG=cogs
S3_BUCKET_MEDIA=media
S3_ACCESS_KEY=geoportal
S3_SECRET_KEY=change-me-s3

# --- External data ---
DEA_STAC_URL=https://explorer.digitalearth.africa/stac

# --- Hosting ---
# Local: ":80" (published on HTTP_PORT). Staging/prod: the hostname, e.g. geoportal.example.org
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# 1 = install pytest/ruff/mypy into the Django image (local); 0 for prod images
INSTALL_DEV=1
